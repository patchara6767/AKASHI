local function CreateSlider(parent, text, min, max, default, callback)
    local Frame = Instance.new("Frame", parent)
    Frame.Size = UDim2.new(1, -6, 0, 46)
    Frame.BackgroundColor3 = C_CONTAINER
    Frame.ZIndex = 13
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)
    
    local Label = Instance.new("TextLabel", Frame)
    Label.Position = UDim2.new(0, 10, 0, 4)
    Label.Size = UDim2.new(0.6, 0, 0, 18)
    Label.Text = text
    Label.TextColor3 = C_TEXT
    Label.Font = Enum.Font.GothamSemibold
    Label.TextSize = 10
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.BackgroundTransparency = 1
    Label.ZIndex = 14
    
    local ValLabel = Instance.new("TextLabel", Frame)
    ValLabel.Position = UDim2.new(0.65, 0, 0, 4)
    ValLabel.Size = UDim2.new(0.3, 0, 0, 18)
    ValLabel.Text = tostring(default)
    ValLabel.TextColor3 = C_RED
    ValLabel.Font = Enum.Font.GothamBold
    ValLabel.TextSize = 10
    ValLabel.TextXAlignment = Enum.TextXAlignment.Right
    ValLabel.BackgroundTransparency = 1
    ValLabel.ZIndex = 14
    
    local SliderBtn = Instance.new("TextButton", Frame)
    SliderBtn.Position = UDim2.new(0, 10, 0, 28)
    SliderBtn.Size = UDim2.new(1, -20, 0, 6)
    SliderBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    SliderBtn.Text = ""
    SliderBtn.ZIndex = 14
    Instance.new("UICorner", SliderBtn).CornerRadius = UDim.new(1, 0)
    
    local SliderFill = Instance.new("Frame", SliderBtn)
    SliderFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    SliderFill.BackgroundColor3 = C_RED
    SliderFill.ZIndex = 15
    Instance.new("UICorner", SliderFill).CornerRadius = UDim.new(1, 0)
    
    local isDragging = false
    local function UpdateSlider(input)
        local pos = math.clamp((input.Position.X - SliderBtn.AbsolutePosition.X) / SliderBtn.AbsoluteSize.X, 0, 1)
        SliderFill.Size = UDim2.new(pos, 0, 1, 0)
        local val = math.floor(min + (pos * (max - min)))
        ValLabel.Text = tostring(val)
        callback(val)
    end
    
    SliderBtn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            UpdateSlider(i)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(i)
        if isDragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            UpdateSlider(i)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
        end
    end)
end

