local autoAnswerWord = false
local autoSendChatWord = true
local wordTypeSpeed = 0.1
local lastSubmitted = ""

local WORD_DATABASE = {
    "APPLE", "BANANA", "CAT", "DOG", "ELEPHANT", "FLOWER", "GIRAFFE", "HOUSE", "ICE", "JUNGLE",
    "KANGAROO", "LION", "MONKEY", "NIGHT", "ORANGE", "PENGUIN", "QUEEN", "RABBIT", "SUN", "TREE",
    "UMBRELLA", "VIOLIN", "WATER", "XYLOPHONE", "YELLOW", "ZEBRA", "ACTION", "BEACH", "CASTLE", "DRAGON",
    "EARTH", "FOREST", "GARDEN", "HONEY", "ISLAND", "JACKET", "KING", "LEMON", "MOUNTAIN", "NATURE",
    "OCEAN", "PLANET", "RIVER", "SILVER", "TIGER", "UNIVERSE", "VALLEY", "WINTER", "YOUTH", "ZEAL",
    "BALL", "BIRD", "FISH", "BOOK", "DOOR", "FIRE", "GOLD", "HAND", "MOON", "RAIN", "STAR", "WIND"
}

local function sendChatMessage(msg)
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if generalChannel then generalChannel:SendAsync(msg) end
        else
            ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents"):FindFirstChild("SayMessageRequest"):FireServer(msg, "All")
        end
    end)
end

local function findWordByPrompt(prompt)
    if not prompt or #prompt == 0 then return nil end
    prompt = string.upper(prompt)
    for _, word in ipairs(WORD_DATABASE) do
        if string.find(word, prompt) then return word end
    end
    return prompt .. "ING"
end

local function scanAndSolveWord()
    for _, gui in ipairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled then
            for _, label in ipairs(gui:GetDescendants()) do
                if (label:IsA("TextLabel") or label:IsA("TextBox")) and label.Visible then
                    local txt = label.Text
                    if txt and #txt >= 1 and #txt <= 15 and not string.find(txt, " ") then
                        local solution = findWordByPrompt(txt)
                        if solution and solution ~= lastSubmitted then
                            lastSubmitted = solution
                            if label:IsA("TextBox") then label.Text = solution end
                            if autoSendChatWord then
                                sendChatMessage(solution)
                            else
                                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
                                task.wait(0.05)
                                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
                            end
                            return
                        end
                    end
                end
            end
        end
    end
end

task.spawn(function()
    while true do
        if autoAnswerWord then scanAndSolveWord() end
        task.wait(wordTypeSpeed)
    end
end)

local function doEsp(ch, st)
    local h = ch:FindFirstChild("AkashiESP")
    if st and not h then 
        h = Instance.new("Highlight", ch) 
        h.Name = "AkashiESP" 
        h.FillColor = C_RED 
        h.OutlineColor = Color3.fromRGB(255,255,255) 
        h.FillTransparency = 0.5 
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    elseif not st and h then 
        h:Destroy() 
    end
end

local function fl()
    local c = LocalPlayer.Character 
    local hrp, hum = c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid") 
    if not hrp or not hum then return end
    
    bG, bV = Instance.new("BodyGyro", hrp), Instance.new("BodyVelocity", hrp) 
    bG.P, bG.maxTorque, bG.cframe = 9e4, Vector3.new(9e9,9e9,9e9), hrp.CFrame 
    bV.velocity, bV.maxForce, hum.PlatformStand = Vector3.new(0,0.1,0), Vector3.new(9e9,9e9,9e9), true
end

local function noFl()
    if bG then bG:Destroy() end 
    if bV then bV:Destroy() end 
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") 
    if hum then hum.PlatformStand = false end
end

local function setCharInvis(state)
    local char = LocalPlayer.Character
    if not char then return end
    for _, item in ipairs(char:GetDescendants()) do
        if item:IsA("BasePart") or item:IsA("Decal") then
            if item.Name ~= "HumanoidRootPart" or not state then
                item.Transparency = state and 1 or 0
            end
        end
    end
end

