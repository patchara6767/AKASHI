local function fl()
    local c = LP.Character local hrp, hum = c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid") if not hrp or not hum then return end
    bG, bV = Instance.new("BodyGyro", hrp), Instance.new("BodyVelocity", hrp) bG.P, bG.maxTorque, bG.cframe = 9e4, Vector3.new(9e9,9e9,9e9), hrp.CFrame bV.velocity, bV.maxForce, hum.PlatformStand = Vector3.new(0,0.1,0), Vector3.new(9e9,9e9,9e9), true
end
local function noFl()
    if bG then bG:Destroy() end if bV then bV:Destroy() end local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") if hum then hum.PlatformStand = false end
end
tF.Activated:Connect(function() eF = not eF anim(eF, tF, bF) if eF then fl() else noFl() end end)
