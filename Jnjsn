local function doEsp(ch, st)
    local h = ch:FindFirstChild("AkashiESP")
    if st and not h then h = Instance.new("Highlight", ch) h.Name = "AkashiESP" h.FillColor, h.OutlineColor, h.FillTransparency, h.DepthMode = Color3.fromRGB(210,0,0), Color3.fromRGB(255,255,255), 0.5, Enum.HighlightDepthMode.AlwaysOnTop
    elseif not st and h then h:Destroy() end
end
