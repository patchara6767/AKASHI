local function anim(st, sw, b)
    TS:Create(sw, TweenInfo.new(0.1), {BackgroundColor3 = st and Color3.fromRGB(210,0,0) or Color3.fromRGB(200,200,200)}):Play()
    TS:Create(b, TweenInfo.new(0.1), {Position = st and UDim2.new(0,22,0,2) or UDim2.new(0,2,0,2)}):Play()
end

