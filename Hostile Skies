local function createToggle(name, text, pos)
    local container = Instance.new("Frame")
    container.Parent = Content
    container.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
    container.BorderSizePixel = 0
    container.Position = pos
    container.Size = UDim2.new(0.9, 0, 0, 40)
    
    local cr = Instance.new("UICorner")
    cr.CornerRadius = UDim.new(0, 6)
    cr.Parent = container

    local label = Instance.new("TextLabel")
    label.Parent = container
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0.05, 0, 0, 0)
    label.Size = UDim2.new(0.6, 0, 1, 0)
    label.Font = Enum.Font.GothamSemibold
    label.Text = text
    label.TextColor3 = Color3.fromRGB(60, 60, 60)
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left

    local switch = Instance.new("TextButton")
    switch.Parent = container
    switch.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    switch.Position = UDim2.new(0.75, 0, 0.2, 0)
    switch.Size = UDim2.new(0, 45, 0, 24)
    switch.Text = ""
    
    local scr = Instance.new("UICorner")
    scr.CornerRadius = UDim.new(1, 0)
    scr.Parent = switch

    local ball = Instance.new("Frame")
    ball.Parent = switch
    ball.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    ball.Position = UDim2.new(0, 2, 0, 2)
    ball.Size = UDim2.new(0, 20, 0, 20)
    
    local bcr = Instance.new("UICorner")
    bcr.CornerRadius = UDim.new(1, 0)
    bcr.Parent = ball

    return switch, ball
end

