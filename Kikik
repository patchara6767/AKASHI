local function handleToggle(state, switch, ball)
    local targetColor = state and Color3.fromRGB(210, 0, 0) or Color3.fromRGB(200, 200, 200)
    local targetPos = state and UDim2.new(0, 22, 0, 2) or UDim2.new(0, 2, 0, 2)
    TweenService:Create(switch, TweenInfo.new(0.1), {BackgroundColor3 = targetColor}):Play()
    TweenService:Create(ball, TweenInfo.new(0.1), {Position = targetPos}):Play()
end

AimToggle.Activated:Connect(function() aimEnabled = not aimEnabled handleToggle(aimEnabled, AimToggle, AimBall) end)

local function applyEspEffect(char, state)
    local highlight = char:FindFirstChild("AkashiESP")
    if state then
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "AkashiESP"
            highlight.FillColor, highlight.OutlineColor = Color3.fromRGB(210, 0, 0), Color3.fromRGB(255, 255, 255)
            highlight.FillTransparency, highlight.OutlineTransparency = 0.5, 0
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Parent = char
        end
    else
        if highlight then highlight:Destroy() end
    end
end

EspToggle.Activated:Connect(function()
    espEnabled = not espEnabled
    handleToggle(espEnabled, EspToggle, EspBall)
    if not espEnabled then
        for _, p in ipairs(Players:GetPlayers()) do if p.Character then applyEspEffect(p.Character, false) end end
    end
end)

local function startFly()
    local char = LocalPlayer.Character
    local hrp, humanoid = char and char:FindFirstChild("HumanoidRootPart"), char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end
    bodyGyro = Instance.new("BodyGyro") bodyGyro.P = 9e4 bodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9) bodyGyro.cframe = hrp.CFrame bodyGyro.Parent = hrp
    bodyVelocity = Instance.new("BodyVelocity") bodyVelocity.velocity = Vector3.new(0, 0.1, 0) bodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9) bodyVelocity.Parent = hrp
    humanoid.PlatformStand = true
end

local function stopFly()
    if bodyGyro then bodyGyro:Destroy() end if bodyVelocity then bodyVelocity:Destroy() end
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.PlatformStand = false end
end

