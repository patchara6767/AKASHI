-- ฟังก์ชันสร้างสไลเดอร์สำหรับปรับระยะ FOV ล็อกหัว
local function createSlider(text, startVal, pos)
    local container = Instance.new("Frame")
    container.Parent = Content
    container.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
    container.Position = pos
    container.Size = UDim2.new(0.9, 0, 0, 38)
    
    local cr = Instance.new("UICorner")
    cr.CornerRadius = UDim.new(0, 4)
    cr.Parent = container

    local label = Instance.new("TextLabel")
    label.Parent = container
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0.05, 0, 0, 0)
    label.Size = UDim2.new(0.6, 0, 0.5, 0)
    label.Font = Enum.Font.GothamSemibold
    label.Text = text
    label.TextColor3 = Color3.fromRGB(60, 60, 60)
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Left

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Parent = container
    valueLabel.BackgroundTransparency = 1
    valueLabel.Position = UDim2.new(0.65, 0, 0, 0)
    valueLabel.Size = UDim2.new(0.3, 0, 0.5, 0)
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.Text = tostring(startVal)
    valueLabel.TextColor3 = Color3.fromRGB(210, 0, 0)
    valueLabel.TextSize = 10
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local sliderBar = Instance.new("TextButton")
    sliderBar.Parent = container
    sliderBar.BackgroundColor3 = Color3.fromRGB(210, 210, 210)
    sliderBar.Position = UDim2.new(0.05, 0, 0.65, 0)
    sliderBar.Size = UDim2.new(0.9, 0, 0, 6)
    sliderBar.Text = ""
    
    local sbCr = Instance.new("UICorner")
    sbCr.CornerRadius = UDim.new(1, 0)
    sbCr.Parent = sliderBar

    local sliderFill = Instance.new("Frame")
    sliderFill.Parent = sliderBar
    sliderFill.BackgroundColor3 = Color3.fromRGB(210, 0, 0)
    
    -- คำนวณขนาดเริ่มต้นของแถบสีแดงตามค่าคอนฟิก
    local initPercent = (startVal - 1) / 499
    sliderFill.Size = UDim2.new(initPercent, 0, 1, 0)
    
    local sfCr = Instance.new("UICorner")
    sfCr.CornerRadius = UDim.new(1, 0)
    sfCr.Parent = sliderFill

    return sliderBar, sliderFill, valueLabel
end

