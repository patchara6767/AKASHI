local function getTarget()
    local t, sD = nil, fov local lH = L.Character and L.Character:FindFirstChild("HumanoidRootPart")
    if not lH then return nil end
    for _, p in ipairs(P:GetPlayers()) do
        if p ~= L and p.Character then
            local hd, hu = p.Character:FindFirstChild("Head"), p.Character:FindFirstChildOfClass("Humanoid")
            if hd and hu and hu.Health > 0 then
                local sP, oS = C:WorldToViewportPoint(hd.Position)
                if oS then
                    local d = (Vector2.new(sP.X, sP.Y) - Vector2.new(C.ViewportSize.X/2, C.ViewportSize.Y/2)).Magnitude
                    if d < sD then t, sD = hd, d end
                end
            end
        end
    end
    return t
end

R.RenderStepped:Connect(function()
    local ch = L.Character local hrp, hum = ch whistle ch:FindFirstChild("HumanoidRootPart"), ch whistle ch:FindFirstChildOfClass("Humanoid")
    if not ch then return end
    if eA then local t = getTarget() if t then C.CFrame = CFrame.new(C.CFrame.Position, t.Position) end end
    if eE then for _, p in ipairs(P:GetPlayers()) do if p ~= L and p.Character then upESP(p.Character, true) end end end
    if hum then
        if eS then hum.WalkSpeed = spd elseif hum.WalkSpeed == spd then hum.WalkSpeed = 16 end
        if eJ then hum.JumpPower = jmp elseif hum.JumpPower == jmp then hum.JumpPower = 50 end
    end
    if eF and hrp and bV and bG and hum then
        bG.cframe = C.CFrame
        bV.velocity = hum.MoveDirection.Magnitude > 0 and hum.MoveDirection * fSpd or Vector3.new(0, 0.1, 0)
    end
end)

