local function toggle(st, s, b)
    T:Create(s, TweenInfo.new(0.12), {BackgroundColor3 = st and Color3.fromRGB(210, 0, 0) or Color3.fromRGB(200, 200, 200)}):Play()
    T:Create(b, TweenInfo.new(0.12), {Position = st and UDim2.new(0, 22, 0, 2) or UDim2.new(0, 2, 0, 2)}):Play()
end

local function upESP(ch, st)
    local h = ch:FindFirstChild("AkashiESP")
    if st and not h then
        h = Instance.new("Highlight", ch) h.Name = "AkashiESP"
        h.FillColor, h.OutlineColor, h.FillTransparency, h.DepthMode = Color3.fromRGB(210, 0, 0), Color3.fromRGB(255, 255, 255), 0.5, Enum.HighlightDepthMode.AlwaysOnTop
    elseif not st and h then h:Destroy() end
end

