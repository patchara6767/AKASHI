local function switchTab(activeBtn, targetContent, inactiveBtn, sourceContent)
    targetContent.Visible, sourceContent.Visible = true, false
    T:Create(activeBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(210, 0, 0), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
    activeBtn.Font = Enum.Font.GothamBold
    T:Create(inactiveBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(25, 25, 25), TextColor3 = Color3.fromRGB(160, 160, 160)}):Play()
    inactiveBtn.Font = Enum.Font.GothamMedium
end

Tab1Btn.Activated:Connect(function() switchTab(Tab1Btn, ContentMain, Tab2Btn, ContentPlayer) end)
Tab2Btn.Activated:Connect(function() switchTab(Tab2Btn, ContentPlayer, Tab1Btn, ContentMain) end)

local function animToggle(st, s, b)
    T:Create(s, TweenInfo.new(0.12), {BackgroundColor3 = st and Color3.fromRGB(60, 10, 10) or Color3.fromRGB(45, 45, 45)}):Play()
    T:Create(b, TweenInfo.new(0.12), {
        Position = st and UDim2.new(0, 22, 0, 2) or UDim2.new(0, 2, 0, 2),
        BackgroundColor3 = st and Color3.fromRGB(210, 0, 0) or Color3.fromRGB(140, 140, 140)
    }):Play()
end

tC.Activated:Connect(function() eC = not eC animToggle(eC, tC, bC) end)
tB.Activated:Connect(function() eB = not eB animToggle(eB, tB, bB) end)

